## .gitignore for .NET / ASP.NET Core projects
## https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Visual Studio
.vs/
*.csproj.user
*.dbmdl
*.jfm

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# NuGet Packages
*.nupkg
*.snupkg
# NuGet local cache
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Publish output
publish/

# Certificates and secrets
*.pem
*.p12
*.pfx
*.key
*.crt

# macOS
.DS_Store

# Claude Code
.claude/

# dotnet tool manifest cache
.dotnet/
*.pdb
