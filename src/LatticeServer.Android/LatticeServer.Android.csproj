<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.lattice.server</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!--
      AOT must be off so that template plugin DLLs can be dynamically loaded from APKs
      via AssemblyLoadContext.LoadFromAssemblyPath(). This is a deliberate trade-off:
      plugin support requires interpreter mode.
    -->
    <PublishAot>false</PublishAot>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>
    <!--
      Match the installed Android SDK platform (android-36.1).
      FOREGROUND_SERVICE_SPECIAL_USE requires API 34+, so minSdk is 34.
    -->
    <TargetPlatformVersion>36.1</TargetPlatformVersion>
    <SupportedOSPlatformVersion>34</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LatticeServer/LatticeServer.csproj" />
  </ItemGroup>

  <!--
    ASP.NET Core does not ship a separate Android runtime pack (NETSDK1082).
    Its assemblies reach the APK via the project reference to LatticeServer.
    Suppress the runtime pack resolution for Microsoft.AspNetCore.App on Android.
  -->
  <ItemGroup>
    <KnownFrameworkReference Update="Microsoft.AspNetCore.App"
        RuntimePackNamePatterns=""
        DefaultRuntimeFrameworkVersion="10.0.0"
        LatestRuntimeFrameworkVersion="10.0.0"
        Condition="'$(TargetPlatformIdentifier)' == 'android'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default data bundled into the APK; copied to FilesDir on first launch -->
    <AndroidAsset Include="Assets/**" />
  </ItemGroup>
</Project>
